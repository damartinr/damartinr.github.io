---
layout: default
---
<style>

/* Justify all article text and set paragraph spacing */
.post article, 
.post article .clearfix {
    text-align: justify;
    text-justify: inter-word; /* improves spacing in some browsers */
}

.post article p, 
.post article .clearfix p {
    margin-bottom: 1em; /* equal spacing between paragraphs */
}


  /* Compact styling for the about page */
  .post-header h1 {
    margin-bottom: 0.5rem;
  }
  
  .desc {
    font-size: 1.1rem;
    color: #6c757d;
    margin-bottom: 1.5rem;
  }
  
  /* Compact link styling without underline */
  .section-heading {
    margin: 1.2rem 0 0.8rem 0;
  }
  
  .section-heading a {
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    font-size: 1.25rem;
    font-weight: 600;
  }
  
  /* Subtle hover effect for section headings */
  .section-heading a:hover {
    color: #2c6bed;
  }
  
  /* Project subtitle styling */
  .project-subtitle {
    font-size: 0.95rem;
    color: #6c757d;
    margin-top: -0.4rem;
    margin-bottom: 0.8rem;
    font-style: italic;
  }
  
  /* Compact card styling */
  .card.hoverable {
    transition: all 0.2s ease;
    border: 1px solid rgba(0,0,0,0.08);
    margin-bottom: 1rem;
    border-radius: 6px;
  }
  
  .card.hoverable:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.07) !important;
  }
  
  /* Compact project card adjustments */
  .project-card .card-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  
  .project-card .card-text {
    font-size: 0.85rem;
    color: #6c757d;
    line-height: 1.4;
  }
  
  .project-card .card-body {
    padding: 0.9rem;
  }
  
  /* Two column layout with equal height */
  .two-column-section {
    display: flex;
    flex-wrap: wrap;
    margin: 1.5rem 0;
    gap: 1.2rem;
    align-items: stretch; /* This makes columns equal height */
  }
  
  .column {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
  }
  
  /* Make both sections equal height */
  .posts-container, .projects-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .latest-posts, .project-grid {
    flex: 1;
  }
  
  /* GitHub icon styling */
  .github-icon {
    margin-top: 0.6rem;
  }
  
  .github-icon a {
    color: #24292e;
    font-size: 1rem;
    transition: color 0.2s;
  }
  
  .github-icon a:hover {
    color: #0366d6;
  }
  
  /* Make images in cards smaller */
  .project-card .card-img-top {
    height: 140px;
    object-fit: cover;
  }

  /* Home page projects — primary 1/row, secondary 2/row */
  .home-projects-scroll {
    max-height: 700px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .home-projects-primary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .home-projects-primary .project-card {
    flex: 0 0 auto;
  }

  .home-projects-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .home-projects-secondary .project-card { flex: 0 0 auto; }

  .home-projects-secondary .card-img-top { height: 110px; }

  .home-projects-secondary .card-body { padding: 0.5rem 0.7rem; }

  .home-projects-secondary .card-title {
    font-size: 0.9rem;
    margin-top: 0;
    margin-bottom: 0.15rem;
    line-height: 1.2;
  }

  .home-projects-secondary .card-text {
    font-size: 0.78rem;
    margin-top: 0;
    margin-bottom: 0;
    line-height: 1.3;
  }

  .home-projects-secondary .card-text p { margin-bottom: 0; }

  .home-secondary-heading {
    font-size: 1rem;
    font-weight: 600;
    color: #495057;
    margin: 1.2rem 0 0.2rem 0;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  
  @media (max-width: 768px) {
    .two-column-section {
      flex-direction: column;
      gap: 0.8rem;
    }
    
    .section-heading a {
      font-size: 1.15rem;
    }
    
    .column {
      min-width: 100%;
    }
  }

  /* Scrollable columns so both sides stay the same height */
  .latest-posts, .project-grid {
    max-height: 700px;
    overflow-y: auto;
    padding-right: 0.5rem; /* room for the scrollbar so it doesn't clip content */
  }

  /* Nicer scrollbar */
  .latest-posts::-webkit-scrollbar, .project-grid::-webkit-scrollbar {
    width: 6px;
  }
  .latest-posts::-webkit-scrollbar-thumb, .project-grid::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.15);
    border-radius: 3px;
  }


/* Bookshelf teaser row */
.bookshelf-section {
  margin-top: 1.5rem;
}

.bookshelf-grid {
  display: flex;
  gap: 1.2rem;
  overflow-x: auto;
  padding-bottom: 0.6rem;
  scroll-snap-type: x mandatory;
}

.book-card {
  flex: 0 0 calc(25% - 0.9rem); /* 4 cards per view, accounting for gap */
  text-decoration: none;
  color: inherit;
  scroll-snap-align: start;
}

.book-card .card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 6px;
  height: 100%;
}

.book-card:hover .card {
  transform: translateY(-3px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
}

.book-cover {
  height: 220px;
  object-fit: contain;
  padding: 1rem;
}

.book-cover-placeholder {
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  font-weight: 600;
  font-size: 2rem;
  color: #6c757d;
}

.book-card-body {
  padding: 0.7rem 0.9rem 1rem;
  text-align: center;
}

.book-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1.25;
  margin-bottom: 0.2rem;
}

.book-author {
  font-size: 0.8rem;
  color: #6c757d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Nicer scrollbar to match the other scrollable sections */
.bookshelf-grid::-webkit-scrollbar {
  height: 6px;
}
.bookshelf-grid::-webkit-scrollbar-thumb {
  background: rgba(0,0,0,0.15);
  border-radius: 3px;
}

@media (max-width: 768px) {
  .book-card {
    flex: 0 0 calc(50% - 0.6rem); /* 2 per view on tablets */
  }
}

@media (max-width: 480px) {
  .book-card {
    flex: 0 0 85%; /* ~1 per view on phones, with a peek of the next */
  }
}
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="section-heading">
        <a href="{{ '/news/' | relative_url }}">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Two-column section for Latest Posts and Projects -->
    <div class="two-column-section">
      <!-- Latest Posts Column -->
      {% if page.latest_posts and page.latest_posts.enabled %}
        <div class="column">
          <div class="posts-container">
            <h2 class="section-heading">
              <a href="{{ '/blog/' | relative_url }}">看看我最近在忙什么吧！</a>
            </h2>
            <div class="latest-posts">
              {% include latest_posts.liquid %}
            </div>
          </div>
        </div>
      {% endif %}
      
      <!-- Projects Column -->
      {% if page.projects and page.projects.enabled %}
        <div class="column">
          <div class="projects-container">
            <h2 class="section-heading">
              <a href="{{ '/projects/' | relative_url }}">我正在做的项目！</a>
            </h2>
            <p class="project-subtitle">一窥我当前的工作与研究项目</p>

            <div class="home-projects-scroll">

              <!-- Primary projects: 1 per row -->
              <div class="home-projects-primary">
                {% assign featured_projects = site.projects | where: "featured", true | where_exp: "p", "p.secondary != true" | sort: "importance" | limit: 3 %}
                {% if featured_projects.size > 0 %}
                  {% for project in featured_projects %}
                    <div class="project-card">
                      {% include projects.liquid %}
                    </div>
                  {% endfor %}
                {% else %}
                  {% assign sorted_projects = site.projects | where_exp: "p", "p.secondary != true" | sort: "importance" | limit: 3 %}
                  {% for project in sorted_projects %}
                    <div class="project-card">
                      {% include projects.liquid %}
                    </div>
                  {% endfor %}
                {% endif %}
              </div>

              <!-- Secondary projects: 2 per row -->
              {% assign home_secondary = site.projects | where: "secondary", true | sort: "importance" | limit: 4 %}
              {% if home_secondary.size > 0 %}
                <h3 class="home-secondary-heading">次要项目</h3>
                <div class="home-projects-secondary">
                  {% for project in home_secondary %}
                    <div class="project-card">
                      {% include projects.liquid %}
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

            </div> <!-- /.home-projects-scroll -->
          </div>   <!-- /.projects-container -->
        </div>     <!-- /.column -->
      {% endif %}  <!-- /page.projects.enabled -->
    </div>

    <!-- Bookshelf teaser -->
    {% if page.bookshelf and page.bookshelf.enabled %}
      <div class="bookshelf-section">
        <h2 class="section-heading">
          <a href="{{ '/books/' | relative_url }}">一些读过的书和我对它们的思考！</a>
        </h2>
        <div class="bookshelf-grid">
          {% assign recent_books = site.books | sort: "started" | reverse | limit: 6 %}
          {% for book in recent_books %}
            <a class="book-card" href="{{ book.url | relative_url }}">
              <div class="card h-100 shadow-sm">
                {% if book.cover %}
                  <img class="card-img-top book-cover" alt="{{ book.title }} cover" src="{{ book.cover | relative_url }}">
                {% elsif book.olid %}
                  <img class="card-img-top book-cover" alt="{{ book.title }} cover" src="http://covers.openlibrary.org/b/olid/{{ book.olid }}-L.jpg?default=false">
                {% elsif book.isbn %}
                  <img class="card-img-top book-cover" alt="{{ book.title }} cover" src="http://covers.openlibrary.org/b/isbn/{{ book.isbn }}-L.jpg?default=false">
                {% else %}
                  <div class="book-cover-placeholder">{{ book.title | slice: 0 }}</div>
                {% endif %}
                <div class="book-card-body">
                  <div class="book-title">{{ book.title }}</div>
                  {% if book.author %}
                    <div class="book-author">{{ book.author }}</div>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="section-heading">
        <a href="{{ '/publications/' | relative_url }}">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>