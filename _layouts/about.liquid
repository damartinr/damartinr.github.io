---
layout: default
---
<style>

  /* Compact styling for the about page */
  .post-header h1 {
    margin-bottom: 0.5rem;
  }
  
  .desc {
    font-size: 1.1rem;
    color: #6c757d;
    margin-bottom: 1.5rem;
  }
  
  /* Compact link styling without underline */
  .section-heading {
    margin: 1.2rem 0 0.8rem 0;
  }
  
  .section-heading a {
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    font-size: 1.25rem;
    font-weight: 600;
  }
  
  /* Subtle hover effect for section headings */
  .section-heading a:hover {
    color: #2c6bed;
  }
  
  /* Project subtitle styling */
  .project-subtitle {
    font-size: 0.95rem;
    color: #6c757d;
    margin-top: -0.4rem;
    margin-bottom: 0.8rem;
    font-style: italic;
  }
  
  /* Compact card styling */
  .card.hoverable {
    transition: all 0.2s ease;
    border: 1px solid rgba(0,0,0,0.08);
    margin-bottom: 1rem;
    border-radius: 6px;
  }
  
  .card.hoverable:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.07) !important;
  }
  
  /* Compact project card adjustments */
  .project-card .card-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  
  .project-card .card-text {
    font-size: 0.85rem;
    color: #6c757d;
    line-height: 1.4;
  }
  
  .project-card .card-body {
    padding: 0.9rem;
  }
  
  /* Two column layout with equal height */
  .two-column-section {
    display: flex;
    flex-wrap: wrap;
    margin: 1.5rem 0;
    gap: 1.2rem;
    align-items: stretch; /* This makes columns equal height */
  }
  
  .column {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
  }
  
  /* Make both sections equal height */
  .posts-container, .projects-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .latest-posts, .project-grid {
    flex: 1;
  }
  
  /* GitHub icon styling */
  .github-icon {
    margin-top: 0.6rem;
  }
  
  .github-icon a {
    color: #24292e;
    font-size: 1rem;
    transition: color 0.2s;
  }
  
  .github-icon a:hover {
    color: #0366d6;
  }
  
  /* Make images in cards smaller */
  .project-card .card-img-top {
    height: 140px;
    object-fit: cover;
  }
  
  @media (max-width: 768px) {
    .two-column-section {
      flex-direction: column;
      gap: 0.8rem;
    }
    
    .section-heading a {
      font-size: 1.15rem;
    }
    
    .column {
      min-width: 100%;
    }
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="section-heading">
        <a href="{{ '/news/' | relative_url }}">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Two-column section for Latest Posts and Projects -->
    <div class="two-column-section">
      <!-- Latest Posts Column -->
      {% if page.latest_posts and page.latest_posts.enabled %}
        <div class="column">
          <div class="posts-container">
            <h2 class="section-heading">
              <a href="{{ '/blog/' | relative_url }}">See what I've been up to</a>
            </h2>
            <div class="latest-posts">
              {% include latest_posts.liquid %}
            </div>
          </div>
        </div>
      {% endif %}
      
      <!-- Projects Column -->
      {% if page.projects and page.projects.enabled %}
        <div class="column">
          <div class="projects-container">
            <h2 class="section-heading">
              <a href="{{ '/projects/' | relative_url }}">Projects I'm working on!</a>
            </h2>
            <p class="project-subtitle">A glimpse of my current work and research projects</p>
            <div class="project-grid">
              {% assign featured_projects = site.projects | where: "featured", true | sort: "importance" | limit: 3 %}
              {% if featured_projects.size > 0 %}
                {% for project in featured_projects %}
                  <div class="project-card">
                    {% include projects.liquid %}
                  </div>
                {% endfor %}
              {% else %}
                {% assign sorted_projects = site.projects | sort: "importance" | limit: 3 %}
                {% for project in sorted_projects %}
                  <div class="project-card">
                    {% include projects.liquid %}
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="section-heading">
        <a href="{{ '/publications/' | relative_url }}">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>