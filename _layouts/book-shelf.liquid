---
layout: default
---

<div class="bookshelf">

  <!-- Title + Intro -->
  <div class="header-bar text-center mb-5">
    <h1>Moral Readings</h1>
    <h2>A personal bookshelf of titles I’ve read and found worth sharing</h2>
  </div>

  {% if page.collection and site[page.collection] %}
    {% assign collection = site[page.collection] %}
    {% if collection.size > 0 %}
      
      {% assign sorted = collection | sort: "finished" | reverse %}
      <div class="row g-4">

        {% for item in sorted %}
          <div class="col-md-4 col-sm-6 mb-4">
            <div class="card h-100 text-center shadow-sm transition-card">
              <a href="{{ item.url | relative_url }}">
                {% if item.cover %}
                  <img class="card-img-top p-3" alt="{{ item.title }} cover"
                       src="{{ item.cover | relative_url }}" style="height:250px; object-fit:contain;">
                {% elsif item.olid %}
                  <img class="card-img-top p-3" alt="{{ item.title }} cover"
                       src="http://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false" style="height:250px; object-fit:contain;">
                {% elsif item.isbn %}
                  <img class="card-img-top p-3" alt="{{ item.title }} cover"
                       src="http://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false" style="height:250px; object-fit:contain;">
                {% endif %}
              </a>

              <div class="card-body px-3 pb-3">
                <h5 class="card-title mb-1">
                  <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                </h5>
                {% if item.author %}
                  <p class="card-subtitle text-muted mb-2">{{ item.author }}</p>
                {% endif %}
                {% if item.excerpt %}
                  <p class="card-text small mt-2">{{ item.excerpt }}</p>
                {% endif %}
                {% if item.finished %}
                  <p class="card-meta text-muted small">
                    Finished: {{ item.finished | date: "%B %d, %Y" }}
                  </p>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}

      </div> <!-- close row -->

    {% else %}
      <p>No books found in this collection.</p>
    {% endif %}
  {% else %}
    <p>No collection specified for this page.</p>
  {% endif %}

</div>
